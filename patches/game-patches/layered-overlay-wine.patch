+#ifdef HAVE_LIBXXSHM
+static int layered_overlay_shm_error( Display *display, XErrorEvent *event, void *arg )
+{
+    return 1;
+}
+
+/* Allocate a shared-memory XImage so the X server writes the overlay's pixels straight into
+   shared memory instead of copying the whole frame over the socket on every read. Returns NULL
+   (leaving shmid == -1) on any failure; the caller then falls back to plain XGetImage. */
+static XImage *layered_overlay_create_shm_image( Visual *visual, int depth,
+                                                 unsigned int width, unsigned int height,
+                                                 XShmSegmentInfo *shminfo )
+{
+    XImage *image;
+
+    shminfo->shmid = -1;
+    if (!(image = XShmCreateImage( gdi_display, visual, depth, ZPixmap, NULL, shminfo, width, height )))
+        return NULL;
+    if (image->bytes_per_line & 3) { XDestroyImage( image ); return NULL; }  /* need 32-bit alignment */
+
+    shminfo->shmid = shmget( IPC_PRIVATE, image->bytes_per_line * height, IPC_CREAT | 0700 );
+    if (shminfo->shmid == -1) { XDestroyImage( image ); return NULL; }
+
+    shminfo->shmaddr = shmat( shminfo->shmid, 0, 0 );
+    if (shminfo->shmaddr != (char *)-1)
+    {
+        BOOL ok;
+
+        shminfo->readOnly = False;  /* XShmGetImage has the server WRITE here, so NOT read-only */
+        X11DRV_expect_error( gdi_display, layered_overlay_shm_error, NULL );
+        ok = (XShmAttach( gdi_display, shminfo ) != 0);
+        XSync( gdi_display, False );
+        if (!X11DRV_check_error() && ok)
+        {
+            image->data = shminfo->shmaddr;
+            shmctl( shminfo->shmid, IPC_RMID, 0 );  /* segment is freed once detached */
+            return image;
+        }
+        shmdt( shminfo->shmaddr );
+    }
+    shmctl( shminfo->shmid, IPC_RMID, 0 );
+    shminfo->shmid = -1;
+    XDestroyImage( image );
+    return NULL;
+}
+
+static void layered_overlay_destroy_shm_image( XImage *image, XShmSegmentInfo *shminfo )
+{
+    if (!image) return;
+    if (shminfo->shmid != -1)
+    {
+        XShmDetach( gdi_display, shminfo );
+        shmdt( shminfo->shmaddr );
+        shminfo->shmid = -1;
+    }
+    image->data = NULL;  /* data is shared memory, not Xlib's to free */
+    XDestroyImage( image );
+}
+#endif /* HAVE_LIBXXSHM */
+
+/* Read the overlay client window's pixels. Prefers a persistent MIT-SHM image (the server
+   writes pixels straight into shared memory — no per-frame socket transfer of the whole
+   frame), recreated only when the window resizes, and falls back to XGetImage when SHM is
+   unavailable or momentarily fails. *is_shm marks the persistent image (caller must not free). */
+static XImage *layered_overlay_read_pixels( struct x11drv_client_surface *surface,
+                                            unsigned int width, unsigned int height, BOOL *is_shm )
+{
+    *is_shm = FALSE;
+#ifdef HAVE_LIBXXSHM
+    if (surface->shm_unavailable)
+    {
+        if (surface->shm_retry_count) surface->shm_retry_count--;
+        if (!surface->shm_retry_count) surface->shm_unavailable = FALSE;
+    }
+
+    if (!surface->shm_unavailable)
+    {
+        if (surface->shm_image && (surface->shm_w != width || surface->shm_h != height))
+        {
+            layered_overlay_destroy_shm_image( surface->shm_image, &surface->shm_info );
+            surface->shm_image = NULL;
+        }
+        if (!surface->shm_image)
+        {
+            XWindowAttributes attr;
+
+            if (XGetWindowAttributes( gdi_display, surface->window, &attr ))
+                surface->shm_image = layered_overlay_create_shm_image( attr.visual, attr.depth,
+                                                                       width, height, &surface->shm_info );
+            if (surface->shm_image)
+            {
+                surface->shm_w = width;
+                surface->shm_h = height;
+                surface->shm_retry_count = 0;
+            }
+            else
+            {
+                surface->shm_unavailable = TRUE;
+                surface->shm_retry_count = 60;
+            }
+        }
+        if (surface->shm_image)
+        {
+            BOOL ok;
+
+            X11DRV_expect_error( gdi_display, layered_overlay_shm_error, NULL );
+            ok = XShmGetImage( gdi_display, surface->window, surface->shm_image, 0, 0, AllPlanes );
+            if (!X11DRV_check_error() && ok) { *is_shm = TRUE; return surface->shm_image; }
+            layered_overlay_destroy_shm_image( surface->shm_image, &surface->shm_info );
+            surface->shm_image = NULL;
+            surface->shm_unavailable = TRUE;
+            surface->shm_retry_count = 60;
+            /* Avoid paying a failing SHM request every present; XGetImage handles this frame. */
+        }
+    }
+#endif
+    return XGetImage( gdi_display, surface->window, 0, 0, width, height, AllPlanes, ZPixmap );
+}
+
+static inline unsigned long layered_overlay_get_pixel_fast( const XImage *image, unsigned int x, unsigned int y )
+{
+    DWORD pixel;
+
+    memcpy( &pixel, image->data + y * image->bytes_per_line + x * 4, sizeof(pixel) );
+    return pixel;
+}
+
