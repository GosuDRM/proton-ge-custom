+/* Opt-in via WINE_LAYERED_OVERLAY_SHAPE=1. For borderless WS_EX_LAYERED windows that
+ * paint per-pixel-alpha overlays through a 3D client surface (DWM-glass style, e.g.
+ * desktop/taskbar overlay games), shape the X window to the rendered (non-black) pixels
+ * so transparent areas show the desktop instead of an opaque black box, and let the
+ * window receive mouse input. Disabled by default: no effect on any other game. */
+BOOL layered_overlay_shape_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled == -1)
+    {
+        const char *e = getenv( "WINE_LAYERED_OVERLAY_SHAPE" );
+        enabled = e && atoi( e );
+    }
+    return enabled;
+}
+
+/* Opt-in via WINE_LAYERED_OVERLAY_ALPHA=1|2. Real per-pixel-alpha path: give the
+ * Vulkan overlay window a 32-bit ARGB visual so the X compositor blends transparency
+ * directly (no XShape). Pairs with vkd3d-proton requesting a non-opaque compositeAlpha. */
+BOOL layered_overlay_alpha_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled == -1)
+    {
+        const char *e = getenv( "WINE_LAYERED_OVERLAY_ALPHA" );
+        enabled = e && atoi( e );
+    }
+    return enabled;
+}
+
+#ifdef HAVE_LIBXSHAPE
+/* ALPHA-mode click-through input-shape refresh rate, in Hz. In ALPHA mode the per-present
+ * XGetImage readback feeds ONLY the input (click-through) shape — the visible transparency
+ * is handled by the ARGB visual + compositor, so the readback is pure overhead and the
+ * input shape tolerates being a few ms stale. Throttling it removes the dominant per-frame
+ * cost (a full GPU->CPU readback of the whole overlay every present). Default 60 Hz; set
+ * WINE_LAYERED_OVERLAY_INPUT_HZ=0 to recompute every present (old behaviour). First frame
+ * and every resize always refresh immediately regardless, so the overlay is interactive at
+ * once. SHAPE mode is unaffected: there the readback also gates the visible blit. */
+static unsigned int layered_overlay_input_hz(void)
+{
+    static int hz = -1;
+    if (hz == -1)
+    {
+        const char *e = getenv( "WINE_LAYERED_OVERLAY_INPUT_HZ" );
+        hz = e ? atoi( e ) : 60;
+        if (hz < 0) hz = 0;
+    }
+    return hz;
+}
+
+/* Shape hysteresis in presents: a 4x4 block stays in the shape this many presents after it
+ * was last seen lit, absorbing transient black frames caught mid-render so the shape doesn't
+ * flicker. Tunable via WINE_LAYERED_OVERLAY_HYSTERESIS (default 12; clamped 1..255). */
+static unsigned int layered_overlay_hysteresis(void)
+{
+    static int n = -1;
+    if (n == -1)
+    {
+        const char *e = getenv( "WINE_LAYERED_OVERLAY_HYSTERESIS" );
+        n = e ? atoi( e ) : 12;
+        if (n < 1) n = 1;
+        if (n > 255) n = 255;
+    }
+    return n;
+}
+
+static ULONGLONG layered_overlay_now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return (ULONGLONG)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+#endif
